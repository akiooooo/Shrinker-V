<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Match the original archive worker .NET Framework compatibility switches (sort order and compression). -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Shrinker V by akiooo</AssemblyName>
    <StartupObject>ShrinkerV.Studio.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodePage>65001</CodePage>
    <ApplicationIcon>assets\shrinker-v.ico</ApplicationIcon>
    <OutputPath>dist\</OutputPath>
    <CscToolPath>$(MSBuildProjectDirectory)\tools\microsoft.net.compilers.toolset\tasks\net472</CscToolPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml" />
    <EmbeddedResource Include="assets\GameFormats.Properties.Resources.resources"><LogicalName>GameFormats.Properties.Resources.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\black.bik"><LogicalName>black.bik</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\runtime.zip"><LogicalName>runtime.zip</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\logo.png"><LogicalName>ShrinkerV.Logo.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="licenses\*.txt"><LogicalName>licenses.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
